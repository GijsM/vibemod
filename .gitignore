# The whole server/ tree is runtime state — created by scripts/setup.sh and
# mutated by the live server and the plugin (worlds, configs, generated mods,
# the OpenRouter key in plugins/VibeMod/config.yml). None of it is source.
server/

# --- Gradle build output ---
.gradle/
build/
*/build/

# --- run-paper / smoke-gate servers (downloaded jars, worlds, generated mods) ---
paper/run/

# --- Node tooling for scripts/ ---
scripts/node_modules/
scripts/.rcon-password

# --- misc ---
.DS_Store
*.log
