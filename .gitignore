# The whole server/ tree is runtime state — created by scripts/setup.sh and
# mutated by the live server and the plugin (worlds, configs, generated mods,
# the OpenRouter key in plugins/VibeMod/config.yml). None of it is source.
server/

# --- Gradle build output ---
.gradle/
build/
*/build/

# --- run-paper / smoke-gate servers (downloaded jars, worlds, generated mods) ---
paper/run/

# --- Loom run directories + the throwaway Fabric server the Phase D gate downloads ---
fabric/run/
fabric/smoke/

# --- MDG run directories + the throwaway NeoForge server the Phase E gate builds ---
neoforge/run/
neoforge/runs/
neoforge/smoke/
neoforge/smoke-cache/
# The client gate's game directory: a world, a config, and the mods it seeds.
neoforge/clientgate-run/

# --- Node tooling for scripts/ ---
scripts/node_modules/
scripts/.rcon-password

# --- paper-api jars, one per supported version, downloaded by
# scripts/fetch-api-jars.sh so the offline symbol tools can measure the real
# API vocabulary. Regenerable, ~100MB, never source. ---
paper/api-jars/

# --- misc ---
.DS_Store
*.log
fabric/smoke-cache/

# --- The B5 compile-rate eval's output: raw LLM responses (the resumable
# response cache), the rendered before/after system prompts, the usage log and
# the generated report. Regenerable, and the response cache is a few MB of
# model output that is not source. ---
eval-out/

# --- Same harness, free-tier models. Same reasons; kept in its own directory so
# a free-model study can never collide with, or be mistaken for, a paid run. ---
eval-free/

# --- the V3 live demo driver (a real server, a real key, real generations) ---
fabric/demo/

# --- the V3 stress campaign's one long-running session (scripts/stress-native.sh) ---
fabric/stress/
# --- the stress campaign's real-client run (scripts/stress-client.sh) ---
fabric/stress-client/
fabric/stress-client-server/
fabric/stress-worldgen/
# --- scratch classpath/javap/javac helpers the stress campaign writes ---
build/
