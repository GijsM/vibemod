{
  "schemaVersion": 1,
  "id": "vibemod",
  "version": "3.0.0",
  "name": "VibeMod",
  "description": "Vibe-code gameplay mods from in-game prompts: describe a mod, an LLM writes the Java, VibeMod compiles it in-process and hot-loads it. No restarts, no external services.",
  "authors": ["gijsm"],
  "contact": {
    "sources": "https://github.com/GijsM/vibemod"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.gijsm.vibemod.fabric.VibeModFabric"],
    "client": ["com.gijsm.vibemod.fabric.client.VibeModFabricClient"]
  },
  "mixins": ["vibemod.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
